# --- 核心 ---
RULES_FILE=./rules.json
DATA_DIR=./data

# Feed 健康門檻(毫秒):超過 STALE 強制重連,超過 FAILOVER 切換 OKX 備援
STALE_AFTER_MS=10000
FAILOVER_AFTER_MS=30000

# --- 推播通道 ---
TELEGRAM_BOT_TOKEN=
LINE_CHANNEL_TOKEN=
# 營運告警(feed 斷線/恢復、收款成功)發到這個 Telegram chat
ADMIN_TELEGRAM_CHAT_ID=

# --- 金流(可選;不設 PORT 就是純引擎模式,所有訂閱者視為已付費)---
PORT=8787
BILLING_ENABLED=1
STRIPE_WEBHOOK_SECRET=whsec_...
NOWPAYMENTS_IPN_SECRET=...
